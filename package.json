{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plugma dev",
    "build": "plugma build",
    "preview": "plugma preview",
    "release": "plugma release"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@figma/plugin-typings": "^1.100.2",
    "@types/node": "^24.0.13",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "plugma": "^1.2.10",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10"
  },
  "plugma": {
    "manifest": {
      "id": "figpal-ai-code-generator",
      "name": "FigPal - AI Code Generator",
      "main": "src/main.ts",
      "editorType": [
        "figma",
        "figjam"
      ],
      "parameters": [
        {
          "name": "AI Prompt",
          "key": "prompt",
          "allowFreeform": true,
          "description": "Describe what you want to create or do in Figma"
        }
      ],
      "networkAccess": {
        "allowedDomains": [
          "https://openrouter.ai"
        ],
        "devAllowedDomains": [
          "http://localhost:*",
          "ws://localhost:9001",
          "openrouter.ai"
        ]
      }
    }
  }
}
