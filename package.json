{
	"name": "figpal",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.3",
	"scripts": {
		"dev": "pnpm --parallel --filter @figpal/plugin --filter @figpal/web dev",
		"build": "pnpm --filter @figpal/plugin build && pnpm --filter @figpal/web build",
		"test": "vitest run",
		"e2e": "node e2e/run.ts",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome lint",
		"deploy:web": "pnpm --filter @figpal/web build && ./deploy/deploy.sh",
		"package": "pnpm build && pnpm --filter figpal build",
		"local:install": "pnpm package && node local/dist/cli.js install",
		"local:uninstall": "node local/cli.ts uninstall"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	}
}
