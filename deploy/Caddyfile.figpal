# Add to /etc/caddy/Caddyfile, next to system.maxschulmeister.dev (not to dokploy-apps.caddy).
# Then: caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
figpal.maxschulmeister.dev {
	@tailscale remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	handle @tailscale {
		# skills.sh sends no CORS headers (spike 0.15).
		handle_path /api/skills/* {
			rewrite * /api{path}
			reverse_proxy https://skills.sh {
				header_up Host skills.sh
				header_up -Origin
			}
		}
		# Claude: Anthropic refuses browser requests for subscription accounts (spike 0.3).
		# Remove the browser headers. Set the Claude Code user-agent, which the browser replaces.
		handle_path /api/anthropic/* {
			reverse_proxy https://api.anthropic.com {
				header_up Host api.anthropic.com
				header_up User-Agent {http.request.header.X-Figpal-User-Agent}
				header_up -X-Figpal-User-Agent
				header_up -Origin
				header_up -Referer
				header_up -Anthropic-Dangerous-Direct-Browser-Access
				header_up -Sec-*
				header_up -X-Forwarded-*
				header_up -Via
			}
		}
		# Codex inference: chatgpt.com allows CORS only from localhost (spike 0.4).
		handle_path /api/chatgpt/* {
			reverse_proxy https://chatgpt.com {
				header_up Host chatgpt.com
				header_up -Origin
			}
		}
		handle {
			root * /srv/figpal
			# Only Figma can show the page in a frame (spike 0.12).
			header Content-Security-Policy "frame-ancestors https://www.figma.com"
			# Hashed file names under /assets. Everything else (index.html for every route) must revalidate.
			@immutable path /assets/*
			header @immutable Cache-Control "public, max-age=31536000, immutable"
			@mutable not path /assets/*
			header @mutable Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
	handle {
		respond "Not Found" 404
	}
}
